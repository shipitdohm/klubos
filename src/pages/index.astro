---
/*
 * Transitional bridge: the refined static landing page remains the visual
 * source of truth while the Astro route structure is being migrated.
 * Keeping the body here prevents the production build from falling back to
 * the older scaffold landing page.
 */
import source from '../../index.html?raw';

const head = source.match(/<head[^>]*>([\s\S]*?)<\/head>/i)?.[1] ?? '';
const body = source.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? '';
---

<!doctype html>
<html lang="de">
  <head set:html={head}></head>
  <body set:html={body}></body>
</html>
