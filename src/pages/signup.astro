---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Registrieren — ClubOS">
  <div class="page-center">
    <div class="auth-card">
      <a href="/" class="logo" aria-label="ClubOS">
        <img
          src="/mr8as03a-clubos_logo_white_transparent.png"
          alt="ClubOS"
          class="brand-logo-image auth-logo-image"
        />
      </a>

      <h2 style="font-size:1.25rem;font-weight:600;letter-spacing:-0.02em;margin-bottom:0.375rem">
        Verein anlegen
      </h2>
      <p style="font-size:0.875rem;color:var(--fg-muted);margin-bottom:1.75rem">
        Starte kostenlos mit ClubOS für deinen Verein.
      </p>

      <form novalidate>
        <div class="form-group">
          <label class="form-label" for="verein">Vereinsname</label>
          <input class="input" id="verein" type="text" placeholder="TSV Musterstadt e.V." required />
        </div>
        <div class="form-group">
          <label class="form-label" for="email">E-Mail</label>
          <input class="input" id="email" type="email" placeholder="vorstand@verein.de" required />
        </div>
        <button type="submit" class="btn btn-primary btn-lg" style="width:100%;margin-top:0.5rem">
          Konto erstellen
        </button>
      </form>

      <hr class="form-divider" />
      <p style="text-align:center;font-size:0.8125rem;color:var(--fg-muted)">
        Bereits registriert? <a href="/login" style="color:var(--accent);font-weight:500">Einloggen</a>
      </p>
    </div>
  </div>
</BaseLayout>
