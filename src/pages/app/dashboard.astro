---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Dashboard — KlubOS" activeNav="dashboard">
  <section class="card" style="padding:1.5rem">
    <h1 style="font-size:1.35rem;margin-bottom:0.5rem">Guten Tag, Admin</h1>
    <p style="color:var(--fg-muted);margin-bottom:1.25rem">
      Willkommen im KlubOS Dashboard. Diese Seite ist das Astro-Gerüst — der vollständige
      Prototyp liegt weiterhin unter <a href="/legacy/dashboard.html" style="color:var(--accent)">legacy/dashboard.html</a>.
    </p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:0.75rem">
      <article class="card" style="padding:1rem;background:var(--surface-2)">
        <p style="font-size:0.75rem;color:var(--fg-muted)">Mitglieder</p>
        <p style="font-size:1.5rem;font-weight:700">342</p>
      </article>
      <article class="card" style="padding:1rem;background:var(--surface-2)">
        <p style="font-size:0.75rem;color:var(--fg-muted)">Offene Beiträge</p>
        <p style="font-size:1.5rem;font-weight:700">12</p>
      </article>
      <article class="card" style="padding:1rem;background:var(--surface-2)">
        <p style="font-size:0.75rem;color:var(--fg-muted)">Events diese Woche</p>
        <p style="font-size:1.5rem;font-weight:700">4</p>
      </article>
    </div>
  </section>
</AppLayout>
