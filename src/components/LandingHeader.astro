---
const links = [
  { href: '/vereinssuche.html', label: 'Verein entdecken' },
  { href: '/#vergleich', label: 'Ohne / mit KlubOS' },
  { href: '/login', label: 'Einloggen' },
];
---

<header class="landing-header" style="position:fixed;left:50%;transform:translateX(-50%);width:min(900px,calc(100% - 2rem));top:0.85rem;border-radius:18px;border:0.5px solid rgba(255,255,255,0.42);box-shadow:0 8px 24px rgba(17,24,39,0.045),inset 0 1px 0 rgba(255,255,255,0.62),inset 0 -1px 0 rgba(17,24,39,0.025);background:linear-gradient(135deg,rgba(255,255,255,0.34),rgba(255,255,255,0.08));backdrop-filter:blur(34px) saturate(220%) contrast(112%);-webkit-backdrop-filter:blur(34px) saturate(220%) contrast(112%)">
  <a href="/" class="logo" aria-label="KlubOS">
    <img
      src="/mr8as03a-klubos_logo_white_transparent.png"
      alt="KlubOS"
      class="brand-logo-image"
      width="120"
      height="32"
    />
  </a>

  <nav class="landing-nav" aria-label="Hauptnavigation">
    {
      links.map((link) => (
        <a href={link.href} class="landing-nav-link">{link.label}</a>
      ))
    }
  </nav>

  <a href="/pilot.html" class="btn btn-primary btn-sm">Pilot besprechen</a>
</header>
